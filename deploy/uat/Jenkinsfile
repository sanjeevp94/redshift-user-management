pipeline {
    agent any

    environment {
        // Assume mapping credentials to specific environment variables
        REDSHIFT_USER = credentials("rs-user-uat")
        REDSHIFT_PASSWORD = credentials("rs-password-uat")
    }

    parameters {
        choice(name: 'ACTION', choices: ['plan', 'apply'], description: 'Choose whether to just plan or apply the configuration.')
        string(name: 'TARGET_CLUSTER', defaultValue: '', description: 'Optional: Filter execution to a specific target host (e.g., uat-cluster). Leaves blank to execute against all clusters.')
    }

    stages {
        stage('Setup') {
            steps {
                sh 'curl -LsSf https://astral.sh/uv/install.sh | sh'
                sh 'export PATH="$HOME/.cargo/bin:$PATH" && uv sync'
            }
        }

        stage('Pre-commit Checks') {
            steps {
                sh 'export PATH="$HOME/.cargo/bin:$PATH" && uv tool install prek'
                sh 'export PATH="$HOME/.cargo/bin:$PATH" && prek run --all-files'
            }
        }

        stage('Liquibase Migrations') {
            steps {
                script {
                    def targetArg = params.TARGET_CLUSTER ? "--target=${params.TARGET_CLUSTER}" : ""
                    sh "python3 scripts/run_liquibase.py deploy/uat/config.yaml deploy/uat/changelog.yaml ${targetArg}"
                }
            }
        }

        stage('Plan Permissions') {
            steps {
                script {
                    def targetArg = params.TARGET_CLUSTER ? "--target=${params.TARGET_CLUSTER}" : ""
                    sh "export PATH=\"\$HOME/.cargo/bin:\$PATH\" && uv run rum plan --config=deploy/uat/config.yaml ${targetArg}"
                }
            }
        }

        stage('Apply Permissions') {
            when {
                expression { params.ACTION == 'apply' }
            }
            steps {
                script {
                    def targetArg = params.TARGET_CLUSTER ? "--target=${params.TARGET_CLUSTER}" : ""
                    sh "export PATH=\"\$HOME/.cargo/bin:\$PATH\" && uv run rum apply --config=deploy/uat/config.yaml --auto_approve=True ${targetArg}"
                }
            }
        }
    }
}
